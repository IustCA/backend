# Which settings module to load.
#   development -> A.settings.development  (DEBUG=True,  permissive)
#   production  -> A.settings.production   (DEBUG=False, secure defaults)
#   local       -> A.settings.local        (your own overrides)
APP_ENV=development

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database
DB_NAME=db.sqlite3

# JWT
JWT_ACCESS_LIFETIME_DAYS=1
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL_ORIGINS=True
